# Copy this file to `.env` beside compose.yaml and change the two folders.
# Both must already exist and belong to WAYFETCH_UID:WAYFETCH_GID.

# Wayfetch's own data: job database, API token, account key, browser
# sign-in. Back this folder up. For example:
WAYFETCH_DATA=/srv/wayfetch/data
# Where downloads are saved.
WAYFETCH_DOWNLOADS=/srv/wayfetch/downloads

# Optional; the defaults are shown.
# The user the container runs as. It must own both folders.
#WAYFETCH_UID=1000
#WAYFETCH_GID=1000
# Where port 7878 is published. The default lets only this machine in;
# read deploy/README.md before opening it to the network.
#WAYFETCH_PUBLISH=127.0.0.1:7878
# The image to run: wayfetch:local builds it from this repository, or a
# published one such as ghcr.io/yaphoa/wayfetch-downloader:v0.1.1.
#WAYFETCH_IMAGE=wayfetch:local
