{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wayfetch Downloader",
  "identifier": "io.github.yaphoa.wayfetch",
  "build": {
    "frontendDist": "../../ui/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wayfetch Downloader",
        "width": 1400,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "require-trusted-types-for": "'script'",
        "trusted-types": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Utility",
    "shortDescription": "A download manager with its engine built in",
    "longDescription": "Wayfetch Downloader downloads files and videos, resumes interrupted downloads, and keeps everything on this computer. No account or online service is needed.",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/YAPhoa/wayfetch-downloader",
    "linux": {
      "deb": {
        "section": "net",
        "recommends": ["python3 (>= 3.10)", "ffmpeg"],
        "files": {
          "/usr/lib/wayfetch-downloader/plugins": "../../target/desktop-plugins"
        }
      },
      "rpm": {
        "recommends": ["python3 >= 3.10", "/usr/bin/ffmpeg"],
        "files": {
          "/usr/lib/wayfetch-downloader/plugins": "../../target/desktop-plugins"
        }
      }
    }
  }
}
